%%%%%%%%%%%%%%%%%%%%
%%% HYPERREF SUPPORT
%%%%%%%%%%%%%%%%%%%%
\newcommand{\enlp@hylink}[2]{%
  \ifdefined\hyperlink
    \hyperlink{cite.#1}{#2}%
  \else
    #2%
  \fi
}

%%%%%%%%%%%%%%%%%%%%
%%% APA CITATION %%%
%%%%%%%%%%%%%%%%%%%%

% cite punctuations
\def\BBOP{(}
\def\BBAA{and}
\def\BBAB{and}
\def\BBAY{\ }
\def\BBC{; \allowbreak}
\def\BBN{, \allowbreak}
\def\BBCP{)}
\def\BBOQ{``}
\def\BBCQ{''}
\def\BBOB{[}
\def\BBCB{]}
\def\BBA{\BBAA}

\def\citepunct#1#2#3#4#5#6#7#8#9{%
    \def\BBOP{#1}
    \def\BBAA{#2}
    \def\BBAB{#3}
    \def\BBAY{#4}
    \def\BBC{#5}
    \def\BBN{#6}
    \def\BBCP{#7}
    \def\BBOQ{#8}
    \def\BBCQ{#9}
    \def\BBA{\BBAA}
    \citepunct@contd
}

\def\citepunct@contd#1#2{%
    \def\BBOB{#1}
    \def\BBCB{#2}
}

\def\BBACOMMA{,}
\def\NoCommaBetweenTwoAuthors{\def\BBACOMMA{}}

\let\Bem\em

% cite labels
\def\BED{ (Ed.)}
\def\BEDS{ (Eds.)}
\def\BVOL{Vol.}
\def\BNUM{No.}
\def\BEd{edition}
\def\BPG{p.}
\def\BPGS{pp.}
\def\BCH{Chap.}
\def\BTR{Tech.\ rep.}

\def\citelabels#1#2#3#4#5#6#7#8#9{%
    \def\BED{#1}
    \def\BEDS{#2}
    \def\BVOL{#3}
    \def\BNUM{#4}
    \def\BEd{#5}
    \def\BPG{#6}
    \def\BPGS{#7}
    \def\BCH{#8}
    \def\BTR{#9}
}

% upper or lowercase article titles
\def\@Ucase#1{\uppercase{#1}}
\def\BUcase#1{\lowercase{\@Ucase #1}}
\def\NoTitleCaseChange{\def\BUcase##1{##1}}

% Older jlreq versions forward \@item's label without its outer braces.
% Keep the optional \raisebox dimensions out of the label's token list.
\newcommand*{\enlp@bibanchor}[1]{%
    \ifdefined\hypertarget
        \raisebox{\baselineskip}[0pt][0pt]{\hypertarget{cite.#1}{}}%
    \fi
}

\def\@lbibitem[#1]#2{%
    \def\BBA{\BBAA}%
    \refstepcounter{enumiv}%
    \item[{\enlp@bibanchor{#2}\@biblabel{\theenumiv}}]%
    \if@filesw
    {%
        \def\BBA{\string\BBA}%
        \def\protect##1{\string ##1\space}\immediate
        \write\@auxout{\string\bibcite{#2}{#1}}%
        \def\BBA{\BBAA}
    }%
    \fi
    \ignorespaces
}

% The .bbl and .aux files use \BCAY{full name}{short name}{year}.
% Store the original label in LaTeX's bibliography namespace so the kernel
% can compare labels when it rereads the .aux file at the end of the run.
\ExplSyntaxOn
\cs_set_protected:Npn \bibcite #1#2
  { \@newl@bel { b } {#1} {#2} }

\clist_new:N \l__enlp_cite_keys_clist
\tl_new:N \l__enlp_cite_name_tl
\tl_new:N \l__enlp_cite_previous_name_tl
\tl_new:N \l__enlp_cite_year_tl
\bool_new:N \l__enlp_cite_first_bool

\cs_new_protected:Npn \__enlp_cite_write:n #1
  {
    \legacy_if:nT { @filesw }
      { \iow_now:Ne \@auxout { \token_to_str:N \citation {#1} } }
  }

\cs_new_protected:Npn \__enlp_cite_warn:n #1
  {
    \G@refundefinedtrue
    \@latex@warning { Citation~`#1'~on~page~\thepage\space undefined }
  }

\cs_new_protected:Npn \__enlp_cite_unpack:w \BCAY #1#2#3 \q_stop
  {
    \tl_set:Ne \l__enlp_cite_name_tl
      { \__enlp_cite_select:nn { \exp_not:n {#1} } { \exp_not:n {#2} } }
    \tl_set:Nn \l__enlp_cite_year_tl {#3}
  }

\cs_new_protected:Npn \__enlp_cite_read:n #1
  {
    \tl_clear:N \l__enlp_cite_name_tl
    \cs_if_exist:cTF { b@#1 }
      {
        \tl_set:Nv \l__enlp_cite_year_tl { b@#1 }
        \tl_if_head_eq_meaning:VNT \l__enlp_cite_year_tl \BCAY
          { \exp_after:wN \__enlp_cite_unpack:w \l__enlp_cite_year_tl \q_stop }
      }
      {
        \tl_set:Nn \l__enlp_cite_year_tl { ? }
        \__enlp_cite_warn:n {#1}
      }
  }

\prg_new_conditional:Npnn \__enlp_cite_same_name: { TF }
  {
    \tl_if_empty:NTF \l__enlp_cite_name_tl
      { \prg_return_false: }
      {
        \tl_if_eq:NNTF \l__enlp_cite_name_tl \l__enlp_cite_previous_name_tl
          { \prg_return_true: }
          { \prg_return_false: }
      }
  }

\cs_new_protected:Npn \__enlp_cite_link:nn #1#2
  {
    \cs_if_exist:cTF { b@#1 }
      { \enlp@hylink {#1} {#2} }
      {#2}
  }

% Preserve the interword space that followed each grouped separator.
\cs_new:Npn \__enlp_cite_separator:n #1
  { {#1} \c_space_tl }

\cs_new_protected:Npn \__enlp_cite_parenthetical_item:n #1
  {
    \__enlp_cite_same_name:TF
      {
        \__enlp_cite_separator:n { ,\ }
        \__enlp_cite_link:nn {#1} { \l__enlp_cite_year_tl }
      }
      {
        \bool_if:NF \l__enlp_cite_first_bool { \__enlp_cite_separator:n { \BBC } }
        \__enlp_cite_link:nn {#1}
          {
            \tl_if_empty:NF \l__enlp_cite_name_tl { \l__enlp_cite_name_tl \BBAY }
            \l__enlp_cite_year_tl
          }
      }
  }

\cs_new_protected:Npn \__enlp_cite_textual_item:n #1
  {
    \__enlp_cite_same_name:TF
      { \__enlp_cite_separator:n { ,\ } }
      {
        \bool_if:NF \l__enlp_cite_first_bool { \__enlp_cite_separator:n { \BBCP ,\ } }
        \tl_if_empty:NF \l__enlp_cite_name_tl
          { \__enlp_cite_link:nn {#1} { \l__enlp_cite_name_tl } \ }
        \BBOP
      }
    \__enlp_cite_link:nn {#1} { \l__enlp_cite_year_tl }
  }

\cs_new_protected:Npn \__enlp_cite_author_item:n #1
  {
    \__enlp_cite_same_name:TF
      { }
      {
        \bool_if:NF \l__enlp_cite_first_bool { \__enlp_cite_separator:n { ,\ } }
        \__enlp_cite_link:nn {#1}
          {
            \tl_if_empty:NTF \l__enlp_cite_name_tl
              { \l__enlp_cite_year_tl }
              { \l__enlp_cite_name_tl }
          }
      }
  }

\cs_new_protected:Npn \__enlp_cite_year_item:n #1
  {
    \bool_if:NF \l__enlp_cite_first_bool { \__enlp_cite_separator:n { ,\ } }
    \__enlp_cite_link:nn {#1} { \l__enlp_cite_year_tl }
  }

% The first three arguments select the name form, conjunction and renderer.
% The remaining arguments are the surrounding text and the citation keys.
\cs_new_protected:Npn \__enlp_cite_map:NNNnnn #1#2#3#4#5#6
  {
    \group_begin:
      \cs_set_eq:NN \__enlp_cite_select:nn #1
      \cs_set_eq:NN \BBA #2
      \bool_set_true:N \l__enlp_cite_first_bool
      \tl_clear:N \l__enlp_cite_previous_name_tl
      \__enlp_cite_write:n {#6}
      \clist_set:Ne \l__enlp_cite_keys_clist {#6}
      #4
      \clist_map_inline:Nn \l__enlp_cite_keys_clist
        {
          \__enlp_cite_read:n {##1}
          #3 {##1}
          \tl_set_eq:NN \l__enlp_cite_previous_name_tl \l__enlp_cite_name_tl
          \bool_set_false:N \l__enlp_cite_first_bool
        }
      #5
    \group_end:
  }

\cs_new:Npn \__enlp_cite_postnote:n #1
  { \IfValueT {#1} { { \BBN #1 } } }

\cs_new_protected:Npn \__enlp_cite_parenthetical:Nnnn #1#2#3#4
  {
    \__enlp_cite_map:NNNnnn #1 \BBAA \__enlp_cite_parenthetical_item:n
      { \BBOP \IfValueT {#2} { { \ignorespaces #2 \space } } }
      { \__enlp_cite_postnote:n {#3} \BBCP }
      {#4}
  }

\cs_new_protected:Npn \__enlp_cite_textual:Nnn #1#2#3
  {
    \__enlp_cite_map:NNNnnn #1 \BBAB \__enlp_cite_textual_item:n
      { } { \__enlp_cite_postnote:n {#2} \BBCP } {#3}
  }

\cs_new_protected:Npn \__enlp_cite_author:Nn #1#2
  { \__enlp_cite_map:NNNnnn #1 \BBAB \__enlp_cite_author_item:n { } { } {#2} }

\RenewDocumentCommand \cite { d<> o m }
  { \__enlp_cite_parenthetical:Nnnn \BCA {#1} {#2} {#3} }
\NewDocumentCommand \fullcite { d<> o m }
  { \__enlp_cite_parenthetical:Nnnn \use_i:nn {#1} {#2} {#3} }
\NewDocumentCommand \shortcite { d<> o m }
  { \__enlp_cite_parenthetical:Nnnn \use_ii:nn {#1} {#2} {#3} }

\NewDocumentCommand \citeA { o m }
  { \__enlp_cite_textual:Nnn \BCA {#1} {#2} }
\NewDocumentCommand \fullciteA { o m }
  { \__enlp_cite_textual:Nnn \use_i:nn {#1} {#2} }
\NewDocumentCommand \shortciteA { o m }
  { \__enlp_cite_textual:Nnn \use_ii:nn {#1} {#2} }

\NewDocumentCommand \citeauthor { m }
  { \__enlp_cite_author:Nn \BCA {#1} }
\NewDocumentCommand \fullciteauthor { m }
  { \__enlp_cite_author:Nn \use_i:nn {#1} }
\NewDocumentCommand \shortciteauthor { m }
  { \__enlp_cite_author:Nn \use_ii:nn {#1} }

\NewDocumentCommand \citeyear { o m }
  {
    \__enlp_cite_map:NNNnnn \BCA \BBAB \__enlp_cite_year_item:n
      { \BBOP } { \__enlp_cite_postnote:n {#1} \BBCP } {#2}
  }

\RenewDocumentCommand \nocite { m }
  {
    \@bsphack
    \group_begin:
      \__enlp_cite_write:n {#1}
      \clist_set:Ne \l__enlp_cite_keys_clist {#1}
      \clist_map_inline:Nn \l__enlp_cite_keys_clist
        {
          \str_if_eq:nnF {##1} { * }
            { \cs_if_exist:cF { b@##1 } { \__enlp_cite_warn:n {##1} } }
        }
    \group_end:
    \@esphack
  }

\NewCommandCopy \citeB \citeA
\NewCommandCopy \fullciteB \fullciteA
\NewCommandCopy \shortciteB \shortciteA
\NewCommandCopy \citeC \citeauthor
\NewCommandCopy \fullciteC \fullciteauthor
\NewCommandCopy \shortciteC \shortciteauthor
\ExplSyntaxOff

\def\Bbf{\bf}
\NoCommaBetweenTwoAuthors

\def\Jem#1{#1}
\def\Jetal{他}
\def\JBA{，}
\def\JBOQ{}
\def\JBCQ{}
\def\JED{（編）\inhibitglue}
\def\JEDS{（編）\inhibitglue}
\def\JEd{版}
\def\JCH{章}
\def\JTR{テクニカル・レポート}
\def\JVOL{巻}
\def\JNUM{号}
\def\Turl#1{\texttt{#1}}

\providecommand{\BCA}[2]{#2}
\providecommand{\BCAY}[3]{\BCA{#1}{#2}} 

\renewenvironment{thebibliography}[1]{%
    \clearpage
    \enlp@bibliographyheading{\refname}%
    \list{\@biblabel{\@arabic\c@enumiv}}{%
        \enlp@bibliographylist{\@biblabel{#1}}%
        \usecounter{enumiv}%
        \let\p@enumiv\@empty
        \renewcommand\theenumiv{\@arabic\c@enumiv}%
    }%
    \def\newblock{\hskip .11em plus .33em minus .07em}%
    \enlp@bibliographyparagraphs
    \sfcode`\.=1000\relax
}{%
  \endlist
}

\def\@biblabel#1{[#1]}
\endinput
