% cite punctuations
\def\BBOP{(}
\def\BBAA{and}
\def\BBAB{and}
\def\BBAY{\ }
\def\BBC{; }
\def\BBN{, }
\def\BBC{; \allowbreak}
\def\BBN{, \allowbreak}
\def\BBCP{)}
\def\BBOQ{``}
\def\BBCQ{''}
\def\BBOB{[}
\def\BBCB{]}
\def\BBA{\BBAA}

\def\citepunct#1#2#3#4#5#6#7#8#9{%
    \def\BBOP{#1}
    \def\BBAA{#2}
    \def\BBAB{#3}
    \def\BBAY{#4}
    \def\BBC{#5}
    \def\BBN{#6}
    \def\BBCP{#7}
    \def\BBOQ{#8}
    \def\BBCQ{#9}
    \def\BBA{\BBAA}
    \citepunct@contd
}

\def\citepunct@contd#1#2{%
    \def\BBOB{#1}
    \def\BBCB{#2}
}

\def\BBACOMMA{,}
\def\NoCommaBetweenTwoAuthors{\def\BBACOMMA{}}

\let\Bem\em

% cite labels
\def\BED{ (Ed.)}
\def\BEDS{ (Eds.)}
\def\BVOL{Vol.}
\def\BNUM{No.}
\def\BEd{edition}
\def\BPG{p.}
\def\BPGS{pp.}
\def\BCH{Chap.}
\def\BTR{Tech.\ rep.}

\def\citelabels#1#2#3#4#5#6#7#8#9{%
    \def\BED{#1}
    \def\BEDS{#2}
    \def\BVOL{#3}
    \def\BNUM{#4}
    \def\BEd{#5}
    \def\BPG{#6}
    \def\BPGS{#7}
    \def\BCH{#8}
    \def\BTR{#9}
}

% upper or lowercase article titles
\def\@Ucase#1{\uppercase{#1}}
\def\BUcase#1{\lowercase{\@Ucase #1}}
\def\NoTitleCaseChange{\def\BUcase##1{##1}}

% citations
% Definition of bibliography items (Fixed bracket nesting)
\def\@lbibitem[#1]#2{%
    \def\BBA{\BBAA}%
    \refstepcounter{enumiv}%
    % 修正点: \item の引数全体を {...} で囲んで保護しました
    \item[{\ifdefined\hypertarget\raisebox{\baselineskip}[0pt][0pt]{\hypertarget{cite.#2}{}}\fi\@biblabel{\theenumiv}}]%
    \if@filesw
    {%
        \def\BBA{\string\BBA}%
        \def\protect##1{\string ##1\space}\immediate
        \write\@auxout{\string\bibcite{#2}{#1}}%
        \def\BBA{\BBAA}
    }%
    \fi
    \ignorespaces
}

\def\bibcite#1#2{%
    \global\expandafter\def\csname b@#1\endcsname{#2}% names
    \global\expandafter\def\csname Y@#1\endcsname{\@year@#2}% year
}
\def\@year@\BCAY#1#2#3{#3}

\newif\if@F@cite\@F@citetrue

\def\cite{%
    \def\BCAY##1##2##3{\BCA{##1}{##2}}%
    \@ifnextchar<{\@cite}{\@cite<>}
}

\def\fullcite{%
    \def\BCAY##1##2##3{\BCA{##1}{##1}}%
    \@ifnextchar<{\@cite}{\@cite<>}
}

\def\shortcite{%
    \def\BCAY##1##2##3{\BCA{##2}{##2}}%
    \@ifnextchar<{\@cite}{\@cite<>}
}

\def\@cite<#1>{%
    \@ifnextchar[{%
        \def\@BBN{\BBN}\@@cite<#1>
    }{%
        \def\@BBN{\ignorespaces}\@@cite<#1>[]
    }%
}
\def\@@cite<#1>[#2]#3{%
    \if@filesw\immediate\write\@auxout{\string\citation{#3}}\fi%
    \edef\@citeP{}%
    \BBOP{\ignorespaces#1\space}%
    \@for\@citeb:=#3\do{%
    \@ifundefined{b@\@citeb}{%
        \expandafter\def\csname b@\@citeb\endcsname{?}%
        \expandafter\def\csname Y@\@citeb\endcsname{?}%
        \@warning{Citation `\@citeb' on page \thepage\space undefined}%
    }{\def\BCA##1##2{##2}}%
    \edef\B@my@dummy{\csname b@\@citeb\endcsname}%
    \ifx\@citeP\B@my@dummy%
        \if@F@cite
            \@F@citefalse
        \else
            {,\ }
        \fi%
        \enlp@hylink{\@citeb}{\csname Y@\@citeb\endcsname}%
    \else%
        \if@F@cite
            \@F@citefalse
        \else
            {\BBC}
        \fi%
        \edef\@cite@undefined{?}%
        \ifx\@cite@undefined\B@my@dummy%
            \enlp@hylink{\@citeb}{\csname Y@\@citeb\endcsname}%
        \else%
            \def\BBA{\BBAA}%
            \enlp@hylink{\@citeb}{\csname b@\@citeb\endcsname\BBAY\csname Y@\@citeb\endcsname}%
        \fi%
    \fi%
    \edef\@citeP{\csname b@\@citeb\endcsname}}{\@BBN #2}\BBCP%
    \@F@citetrue
}

\def\citeA{%
    \def\BCAY##1##2##3{\BCA{##1}{##2}}%
    \@ifnextchar[{%
        \def\@BBN{\BBN}\@citeA
    }{%
        \def\@BBN{\ignorespaces}\@citeA[]
    }%
}

\def\fullciteA{%
    \def\BCAY##1##2##3{\BCA{##1}{##1}}%
    \@ifnextchar[{%
        \def\@BBN{\BBN}\@citeA
    }{%
        \def\@BBN{\ignorespaces}\@citeA[]
    }%
}

\def\shortciteA{%
    \def\BCAY##1##2##3{\BCA{##2}{##2}}%
    \@ifnextchar[{%
        \def\@BBN{\BBN}\@citeA
    }{%
        \def\@BBN{\ignorespaces}\@citeA[]
    }%
}

\def\@citeA[#1]#2{%
    \if@filesw\immediate\write\@auxout{\string\citation{#2}}\fi%
    \edef\@citeP{}%
    \@for\@citeb:=#2\do{%
    \@ifundefined{b@\@citeb}{%
        \expandafter\def\csname b@\@citeb\endcsname{?}%
        \expandafter\def\csname Y@\@citeb\endcsname{?}%
        \@warning{Citation `\@citeb' on page \thepage\space undefined}%
    }{\def\BCA##1##2{##2}}%
    \edef\B@my@dummy{\csname b@\@citeb\endcsname}%
    \ifx\@citeP\B@my@dummy%
        \if@F@cite
            \@F@citefalse
        \else
            {,\ }
        \fi%
        \enlp@hylink{\@citeb}{\csname Y@\@citeb\endcsname}%
    \else%
        \if@F@cite
            \@F@citefalse
        \else
            {\BBCP,\ }
        \fi%
        \def\BBA{\BBAB}%
        \enlp@hylink{\@citeb}{\csname b@\@citeb\endcsname}\ \BBOP\enlp@hylink{\@citeb}{\csname Y@\@citeb\endcsname}%
    \fi%
    \edef\@citeP{\csname b@\@citeb\endcsname}}{\@BBN #1}\BBCP%
    \@F@citetrue
}

\def\citeauthor{\def\BCAY##1##2##3{\BCA{##1}{##2}}\@citeauthor}

\def\fullciteauthor{\def\BCAY##1##2##3{\BCA{##1}{##1}}\@citeauthor}

\def\shortciteauthor{\def\BCAY##1##2##3{\BCA{##2}{##2}}\@citeauthor}

\def\@citeauthor#1{%
    \if@filesw
        \immediate\write\@auxout{\string\citation{#1}}%
    \fi%
    \edef\@citeP{}%
    \@for\@citeb:=#1\do{%
        \@ifundefined{b@\@citeb}{%
            \expandafter\def\csname b@\@citeb\endcsname{?}%
            \expandafter\def\csname Y@\@citeb\endcsname{?}%
            \@warning{Citation `\@citeb' on page \thepage\space undefined}%
        }{\def\BCA##1##2{##2}}%
        \edef\B@my@dummy{\csname b@\@citeb\endcsname}%
        \ifx\@citeP\B@my@dummy%
        \else%
            \if@F@cite
                \@F@citefalse
            \else
                {,\ }
            \fi%
        \def\BBA{\BBAB}%
        \enlp@hylink{\@citeb}{\csname b@\@citeb\endcsname}%
        \fi%
        \edef\@citeP{\csname b@\@citeb\endcsname}%
    }%
    \@F@citetrue
}

\def\citeyear{%
    \def\BCAY##1##2##3{}%
    \@ifnextchar[{%
        \def\@BBN{\BBN}\@citeyear
    }{%
        \def\@BBN{\ignorespaces}\@citeyear[]
    }%
}

\def\@citeyear[#1]#2{%
    \if@filesw
        \immediate\write\@auxout{\string\citation{#2}}%
    \fi%
    \edef\@citeP{}%
    \BBOP\@for\@citeb:=#2\do{%
        \@ifundefined{b@\@citeb}{%
            \expandafter\def\csname b@\@citeb\endcsname{?}%
            \expandafter\def\csname Y@\@citeb\endcsname{?}%
            \@warning{Citation `\@citeb' on page \thepage\space undefined}%
        }{}%
        \edef\B@my@dummy{\csname b@\@citeb\endcsname}%
        \if@F@cite
            \@F@citefalse
        \else
            {,\ }
        \fi%
        \enlp@hylink{\@citeb}{\csname Y@\@citeb\endcsname}%
        \edef\@citeP{\csname b@\@citeb\endcsname}%
    }{\@BBN #1}\BBCP%
    \@F@citetrue
}

\def\nocite#1{%
    \@bsphack
    \if@filesw
        \immediate\write\@auxout{\string\citation{#1}}
    \fi%
    \@for\@citeb:=#1\do{%
        \@ifundefined{b@\@citeb}{%
            \edef\B@my@dummy{*}%
            \ifx\@citeb\B@my@dummy
            \else
                \@warning{Citation `\@citeb' on page \thepage\space undefined}
            \fi
        }{}}%
    \@esphack
}

\let\citeB=\citeA
\let\fullciteB=\fullciteA
\let\shortciteB=\shortciteA

\let\citeC=\citeauthor
\let\fullciteC=\fullciteauthor
\let\shortciteC=\shortciteauthor

